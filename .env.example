# Public production URL — used for SEO metadata, OpenGraph, canonical links and the sitemap.
# Set this to your real deployed domain once live (e.g. https://aman-srivastav.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. A GitHub personal access token (no scopes needed for public data) raises the
# GitHub REST API rate limit for the server-side GitHub integration. Without it, the
# integration still works using unauthenticated requests, and falls back to cached data
# if the API is unreachable or rate-limited.
GITHUB_TOKEN=

# Required for the contact form to actually send email. Sends via Gmail SMTP using
# the Gmail account below, so messages arrive genuinely from GMAIL_USER.
#
# Setup:
#   1. Enable 2-Step Verification on the Google account: myaccount.google.com/security
#   2. Generate an App Password: myaccount.google.com/apppasswords
#   3. Set GMAIL_USER to the full Gmail address and GMAIL_APP_PASSWORD to the
#      16-character app password (not your regular Google account password).
#
# Without these set, the contact form UI still works but submissions return a clear
# "email delivery isn't configured yet" error instead of failing silently.
GMAIL_USER=
GMAIL_APP_PASSWORD=
